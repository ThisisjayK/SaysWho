# secrets. The key belongs in the shell environment, never in the repo. DATA_CONTRACT.md §8: the key is
# read from the environment and is never written to disk or committed.
.env
.env.*
*.key

# macOS
.DS_Store

# local tooling config, not part of the project
.claude/

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# stored pages from captures. A full claude.ai page includes the sidebar, and therefore the titles of every
# other conversation, which are real queries from real work. DATA_CONTRACT.md §9 scrubs those before
# anything is committed, so the raw pages stay on the machine.
sayswho-page-*.html
pages/

# captures posted to the local audit server. They hold the answer text and the query behind it, which for
# the professional stratum is real work. They are inputs to the harness, not published artifacts.
captures/

# audits written by the local server. They embed the answer text and quoted spans from the pages fetched,
# which DATA_CONTRACT.md §9 keeps local. The writeup publishes verdicts and spans it has chosen, not a
# directory of everything ever run.
reports/

# fetched pages. DATA_CONTRACT.md §9: the repo publishes verdicts and quoted spans, not copies of the
# pages it fetched.
.cache/

# correspondence with the professor and the TA. Kept locally, not published.
email-to-professor.md
reply-to-professor.md
